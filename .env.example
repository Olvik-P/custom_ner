# Переменные для docker-compose.yml (подстановка Compose'ом в сам YAML,
# не настройки приложения внутри контейнера — те лежат отдельно, в
# privacyguard_pipeline/.env, см. privacyguard_pipeline/.env.example).
# Скопируйте этот файл в .env рядом с docker-compose.yml.

# Директория на хосте с документами, которые должны быть видны файловым
# MCP-инструментам (mask_file/detect/anonymize_pdf) — монтируется в
# /workspace внутри контейнера mcp-ner-pipeline. Пути, передаваемые в эти
# инструменты, должны быть путями внутри контейнера (/workspace/...), а
# не хостовыми.
MCP_HOST_DOCUMENTS_DIR=
