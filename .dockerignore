# Local dev environment / caches - not needed in the image and would
# bloat the build context or leak host-specific state.
.venv-sc/
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/build/

# Secrets - never baked into the image. Pass at `docker run` time via
# --env-file or -e instead.
.env
**/.env

# Logs - the image creates its own empty logs/ dir at build time.
logs/
**/logs/
*.log

# Version control, OpenSpec planning artifacts, local docs, Claude
# Code project files - irrelevant to the runtime image.
.git/
.gitignore
openspec/
docs/
.claude/
CLAUDE.md
README.md

# Repo-root smoke-test scripts - not part of the package, not needed
# to run it.
test.py
test_pdf.py
