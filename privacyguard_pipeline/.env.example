# PrivacyGuard Pipeline — Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider: "openai" (default) or "claude"
LLM_PROVIDER=openai

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Claude API (alternative)
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# Application settings
LOG_LEVEL=INFO
MAX_TEXT_LENGTH=100000

# Detection confidence threshold, 0.0-1.0. Candidates scored below it are
# not masked (e.g. a bare 10-digit number with no "паспорт" nearby).
# 0 disables filtering and restores the pre-scoring behaviour.
MIN_CONFIDENCE=0.5

# Operator lists, each a JSON array of strings (empty by default).
# ALLOW_LIST: never masked (whole span, any case/grammatical form, a leading
# ООО/АО/ПАО... is ignored), e.g. your own company name or support address.
# DENY_LIST: always masked as type CUSTOM everywhere it occurs, e.g. an
# internal project name; deny wins over allow. List content is never logged.
ALLOW_LIST=[]
DENY_LIST=[]

# HTTP API (optional, requires the "api" extra)
API_KEY=
API_KEY_REQUIRED=true
API_PORT=8420

# MCP server (optional, requires the "mcp" extra)
MCP_HANDLE_TTL_SECONDS=300
